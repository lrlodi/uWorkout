# Copie para server/.env e preencha
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/uworkout?schema=public"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
# Origens do frontend separadas por vírgula (aceita curinga, ex.: https://*.vercel.app)
CORS_ORIGINS="http://localhost:5173"
# Opcional: sem a chave, a geração usa o motor local (engine.js)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
FREE_DAILY=2
PORT=3000
