generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  aiUsed       Int      @default(0)
  aiDate       String   @default("")
  plans        Plan[]
  createdAt    DateTime @default(now())
}

model Plan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  goal      String   @default("")
  modality  String
  level     String
  time      Int
  created   String   @default("manual")
  days      Json     // dias, exercícios e corridas (mesma forma do frontend)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
